{
  "stack": "TypeScript",
  "checks": {
    "typecheck": "npm run check"
  },
  "setup": "npm ci --prefer-offline --no-audit --no-fund",
  "tests": {
    "pattern": "^test/[^/]+\\.test\\.ts$",
    "command": "node --disable-warning=ExperimentalWarning --test {tests}"
  },
  "protect": [
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "tsconfig.core.json",
    "tsconfig.cloudflare.json",
    "wrangler.jsonc",
    ".gitignore",
    ".github/"
  ]
}
