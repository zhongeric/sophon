{
  // One Durable Object per PR holds its review runs, one per issue its development runs, and one per program issue its
  // research runs: the ledger, the repository trees and every agent session.
  "name": "agent-factory",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "class_name": "PullRequestRuns", "name": "PULL_REQUESTS" },
      { "class_name": "DevelopmentRuns", "name": "DEVELOPMENT_RUNS" },
      { "class_name": "ResearchRuns", "name": "RESEARCH_RUNS" }
    ]
  },
  "migrations": [
    { "new_sqlite_classes": ["PullRequestRuns"], "tag": "v1" },
    { "new_sqlite_classes": ["DevelopmentRuns"], "tag": "v2" },
    { "new_sqlite_classes": ["ResearchRuns"], "tag": "v3" }
  ],
  // One build container for each development run, each research run (the domain commands) and each review run whose
  // config has tests. Setup, checks, tests and commands run there, never beside a secret. standard-4 is 4 vCPU and
  // 12 GiB: the setup and the tests use all cores, and the parallel builders of a run share it.
  "containers": [
    { "class_name": "DevelopmentRuns", "image": "./containers/build/Dockerfile", "instance_type": "standard-4", "max_instances": 10 },
    { "class_name": "ResearchRuns", "image": "./containers/build/Dockerfile", "instance_type": "standard-4", "max_instances": 5 },
    { "class_name": "PullRequestRuns", "image": "./containers/build/Dockerfile", "instance_type": "standard-4", "max_instances": 10 }
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // The STE dictionary is optional: when agents/guides/ste holds it, it is a module of its own (src/cloudflare/guides.ts).
  "base_dir": "agents/guides",
  "find_additional_modules": true,
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true }
  // Set with: npx wrangler secret put <NAME>
  // GITHUB_TOKEN, GITHUB_WEBHOOK_SECRET, ANTHROPIC_API_KEY, OPENAI_API_KEY, ADMIN_TOKEN, and ALLOWED_USERS: the GitHub
  // logins, comma-separated, that can start runs and answer questions.
}
